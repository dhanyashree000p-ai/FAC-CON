# Neon PostgreSQL Connection String (required in production)
# Obtain this from your Neon Console (Dashboard -> Connection Details -> Connection string)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server Port (Render automatically sets this in production)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development
